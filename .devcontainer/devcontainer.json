{
    "name": "C/C++ Development",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "twxs.cmake",
                "xaver.clang-format"
            ],
            "settings": {
                "cmake.useCMakePresets": "always",
                "cmake.configureOnOpen": true,
                "editor.formatOnSave": true
            }
        }
    },
    "remoteUser": "vscode"
}
